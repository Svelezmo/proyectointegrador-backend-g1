# ── Base de datos de UP News (Supabase) ─────────────────────
# Transaction pooler (6543): lo usa la aplicación.
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (5432): lo usa Prisma para migraciones.
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# ── Supabase (Storage para imágenes/videos) ─────────────────
SUPABASE_URL="https://[REF].supabase.co"
SUPABASE_ANON_KEY=""

# ── Servidor ────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1
# Orígenes exactos de los frontends, separados por comas (sin barra final)
CORS_ORIGINS="http://localhost:5173"
TRUST_PROXY_HOPS=0
AUTH_PERFIL_URL="https://proyecto-asiscoup-g1.onrender.com/api/auth/perfil"

# ── Bot de Telegram ─────────────────────────────────────────
# Token que entrega @BotFather. Vacío = bot desactivado.
TELEGRAM_BOT_TOKEN=""
# Secreto del webhook (16-256 caracteres: letras, números, _ o -).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=""
# URL pública HTTPS del backend desplegado. Vacío = long polling (desarrollo local).
PUBLIC_URL=""

# ── Cloudinary (web y Mini App) ────────────────────────────
# Configurar las tres credenciales juntas; el API secret solo permanece en el backend.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="upnews"
