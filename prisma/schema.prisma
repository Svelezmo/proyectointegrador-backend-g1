generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Modelo de datos de UP News
// Basado en el diagrama Publicación / Evidencia / Métrica
// y en el documento de alcance (bot de Telegram + contacto).
// Convención: modelos en PascalCase, tablas y columnas en snake_case.
// ─────────────────────────────────────────────────────────────

enum RolUpNews {
  DIRECTORA      @map("directora")
  COMUNICACIONES @map("comunicaciones")
  COLABORADOR    @map("colaborador")

  @@map("rol_upnews")
}

enum EstadoPublicacion {
  BORRADOR             @map("borrador")
  PENDIENTE_APROBACION @map("pendiente_aprobacion")
  PUBLICADA            @map("publicada")
  ARCHIVADA            @map("archivada")

  @@map("estado_publicacion")
}

enum TipoEvidencia {
  IMAGEN @map("imagen")
  VIDEO  @map("video")

  @@map("tipo_evidencia")
}

enum TipoInformacionContacto {
  RED_SOCIAL        @map("red_social")
  NUMERO_CONTACTO  @map("numero_contacto")
  DIRECCION         @map("direccion")

  @@map("tipo_informacion_contacto")
}

/// Identidades locales enlazadas a Telegram o al sistema web principal.
model UsuarioAutorizado {
  id                 String    @id @default(uuid(7)) @db.Uuid
  telegramId         BigInt?   @unique @map("telegram_id")
  idUsuarioExterno   BigInt?   @unique @map("id_usuario_externo")
  nombre             String
  rol                RolUpNews @default(COLABORADOR)
  activo             Boolean   @default(true)
  creadoEn           DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn      DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  publicacionesAutor    Publicacion[]          @relation("autor")
  publicacionesAprobada Publicacion[]          @relation("aprobador")
  contactosActualizados InformacionContacto[]

  @@map("usuario_autorizado")
}

model Publicacion {
  id               String            @id @default(uuid(7)) @db.Uuid
  titulo           String
  resumen          String?
  cuerpo           String
  proposito        String?
  etiqueta         String? // "tipo o etiqueta" del documento de alcance
  estado           EstadoPublicacion @default(BORRADOR)
  estaActivo       Boolean           @default(false) @map("esta_activo")
  autorId          String            @map("autor_id") @db.Uuid
  aprobadoPor      String?           @map("aprobado_por") @db.Uuid
  publicadaEn      DateTime?         @map("publicada_en") @db.Timestamptz(6)
  creadoEn         DateTime          @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn    DateTime          @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  autor      UsuarioAutorizado      @relation("autor", fields: [autorId], references: [id])
  aprobador  UsuarioAutorizado?     @relation("aprobador", fields: [aprobadoPor], references: [id])
  evidencias PublicacionEvidencia[]
  metricas   MetricaPublicacion[]

  @@index([estado, publicadaEn(sort: Desc)])
  @@map("publicacion")
}

model Evidencia {
  id            String                 @id @default(uuid(7)) @db.Uuid
  tipo          TipoEvidencia
  url           String
  descripcion   String?
  creadoEn      DateTime               @default(now()) @map("creado_en") @db.Timestamptz(6)
  publicaciones PublicacionEvidencia[]

  @@map("evidencia")
}

model PublicacionEvidencia {
  publicacionId            String  @map("publicacion_id") @db.Uuid
  evidenciaId              String  @map("evidencia_id") @db.Uuid
  consentimientoVerificado Boolean @default(false) @map("consentimiento_verificado")

  publicacion Publicacion @relation(fields: [publicacionId], references: [id], onDelete: Cascade)
  evidencia   Evidencia   @relation(fields: [evidenciaId], references: [id], onDelete: Cascade)

  @@id([publicacionId, evidenciaId])
  @@map("publicacion_evidencia")
}

model MetricaPublicacion {
  id            String   @id @default(uuid(7)) @map("metrica_id") @db.Uuid
  publicacionId String   @map("publicacion_id") @db.Uuid
  fecha         DateTime @db.Date
  vistas        Int      @default(0)
  reacciones    Int      @default(0)
  clics         Int      @default(0)

  publicacion Publicacion @relation(fields: [publicacionId], references: [id], onDelete: Cascade)

  @@unique([publicacionId, fecha])
  @@map("metrica_publicacion")
}

/// Datos de contacto de la fundación administrados desde la API web.
model InformacionContacto {
  id              String                  @id @default(uuid(7)) @db.Uuid
  nombre          String
  tipo            TipoInformacionContacto
  informacion     String
  actualizadoPor  String?                 @map("actualizado_por") @db.Uuid
  actualizadoEn   DateTime                @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  actualizador UsuarioAutorizado? @relation(fields: [actualizadoPor], references: [id])

  @@unique([nombre, tipo])
  @@map("informacion_contacto")
}
